# Local development defaults work without this file. Change both secrets on a VPS.
POSTGRES_PASSWORD=peoplemcp-local
WRITE_TOKEN=local-development-only
BIND_ADDRESS=127.0.0.1
PORT=8000
SEED_DEMO=true
# Host headers accepted by the MCP transport. Add your public hostname.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,api:*
# Browser origins, only needed for browser-based clients.
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
